# Copy to .env.local (never commit it) and fill in.
ANTHROPIC_API_KEY=

# Optional overrides
# GIFTD_MODEL=claude-haiku-5-5          # question-picking calls
# GIFTD_RESULT_MODEL=claude-sonnet-5-5  # gift-picking calls (A/B idea from the plan)
# NEXT_PUBLIC_AMAZON_TAG=               # Amazon Associates tag, once approved
# PEXELS_API_KEY=                       # stock photos on result cards (free at pexels.com/api); without it cards show an emoji tile

# Sharing (/api/share and /r/[id])
# GIFTD_SHARE_SECRET=                   # required in production: any long random string (signs gifts so share links can't be forged)
# UPSTASH_REDIS_REST_URL=               # required in production for share links (or the KV_REST_API_* names Vercel's Upstash integration sets)
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_SITE_URL=                 # optional: your domain, for link previews (Vercel's production URL is used otherwise)
